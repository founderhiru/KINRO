{
  "expo": {
    "name": "Kinro",
    "slug": "canidknot",
    "scheme": "canidknot",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/images/kinro-app-icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.canidknot.app"
    },
    "android": {
      "package": "com.canidknot.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/kinro-android-adaptive-icon.png",
        "backgroundColor": "#FBF8F3"
      },
      "permissions": [],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/kinro-symbol.png",
          "imageWidth": 128,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kinro needs access to your photos so you can add pictures of your dog.",
          "cameraPermission": "Kinro needs access to your camera so you can take a photo of your dog.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d82bc94b-0eb5-4bc5-b02e-efc18daa6642"
      }
    },
    "owner": "rontest"
  }
}
